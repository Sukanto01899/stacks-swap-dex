# Stacks testnet faucet + frontend config
# Copy to .env and fill in real values

# Mnemonic for the deployer that owns token-x and token-y (kept secret)
DEPLOYER_MNEMONIC="replace with your 24-word seed phrase"

# Faucet defaults + switchable networks
# STACKS_NETWORK="testnet" # default network when request body does not set "network"
# FAUCET_ALLOW_MAINNET="false" # must be true to mint on mainnet
# STACKS_NODE="https://api.testnet.hiro.so" # fallback node for both networks
# STACKS_NODE_TESTNET="https://api.testnet.hiro.so"
# STACKS_NODE_MAINNET="https://api.hiro.so"
# STACKS_NODE_DEVNET="http://localhost:3999"
# CONTRACT_ADDRESS="ST1G4ZDXED8XM2XJ4Q4GJ7F4PG4EJQ1KKXVPSAX13" # fallback for both networks
# CONTRACT_ADDRESS_TESTNET="ST1G4ZDXED8XM2XJ4Q4GJ7F4PG4EJQ1KKXVPSAX13"
# CONTRACT_ADDRESS_MAINNET="SP1G4ZDXED8XM2XJ4Q4GJ7F4PG4EJQ1KKXRCD0S3K"
# CONTRACT_ADDRESS_DEVNET="ST1G4ZDXED8XM2XJ4Q4GJ7F4PG4EJQ1KKXVPSAX13"
# FAUCET_PORT=8787
# FAUCET_AMOUNT=5000

# Frontend faucet base URL (used by Vite)
# VITE_FAUCET_URL="http://localhost:8787"
# VITE_STACKS_API="https://api.testnet.hiro.so"
# VITE_CONTRACT_ADDRESS="ST1G4ZDXED8XM2XJ4Q4GJ7F4PG4EJQ1KKXVPSAX13"
# VITE_TOKEN_X="ST1G4ZDXED8XM2XJ4Q4GJ7F4PG4EJQ1KKXVPSAX13.dex-token-x::token-x"
# VITE_TOKEN_Y="ST1G4ZDXED8XM2XJ4Q4GJ7F4PG4EJQ1KKXVPSAX13.dex-token-y::token-y"
# VITE_POOL_CONTRACT="ST1G4ZDXED8XM2XJ4Q4GJ7F4PG4EJQ1KKXVPSAX13.dex-pool-v5"
# VITE_POOLS="ST1G4ZDXED8XM2XJ4Q4GJ7F4PG4EJQ1KKXVPSAX13.dex-pool-v5,ST1G4ZDXED8XM2XJ4Q4GJ7F4PG4EJQ1KKXVPSAX13.dex-pool-v5-alt"
# VITE_STACKS_NETWORK="testnet" # or "mainnet"

# Load test runner
# LOAD_TEST_NETWORK="testnet" # switch to devnet later without changing the script
# LOAD_TEST_FUNDER_MNEMONIC="replace with funding wallet seed phrase"
# LOAD_TEST_NODE_URL="https://api.testnet.hiro.so"
# LOAD_TEST_FAUCET_URL="http://localhost:8787"
# LOAD_TEST_CONTRACT_ADDRESS="ST1G4ZDXED8XM2XJ4Q4GJ7F4PG4EJQ1KKXVPSAX13"
# LOAD_TEST_POOL_CONTRACT="dex-pool-v5"
# LOAD_TEST_TOKEN_X_CONTRACT="dex-token-x"
# LOAD_TEST_TOKEN_Y_CONTRACT="dex-token-y"
# LOAD_TEST_CYCLES=3
# LOAD_TEST_DELAY_MS=4000
# LOAD_TEST_STX_PER_WALLET=0.5
# LOAD_TEST_SWAP_X_AMOUNT=5
# LOAD_TEST_SWAP_Y_AMOUNT=3
# LOAD_TEST_LIQUIDITY_X=8
# LOAD_TEST_LIQUIDITY_Y=8
# LOAD_TEST_REMOVE_RATIO=0.4
