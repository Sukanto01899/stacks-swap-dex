# Stacks testnet faucet + frontend config
# Copy to .env and fill in real values

# Mnemonic for the deployer that owns token-x and token-y (kept secret)
DEPLOYER_MNEMONIC="replace with your 24-word seed phrase"

# Optional: override defaults
# STACKS_NETWORK="mainnet" # or "testnet"
# STACKS_NODE="https://api.hiro.so"
# CONTRACT_ADDRESS="SP1G4ZDXED8XM2XJ4Q4GJ7F4PG4EJQ1KKXRCD0S3K"
# FAUCET_PORT=8787
# FAUCET_AMOUNT=5000

# Frontend faucet base URL (used by Vite)
# VITE_FAUCET_URL="http://localhost:8787"
# VITE_STACKS_API="https://api.testnet.hiro.so"
# VITE_CONTRACT_ADDRESS="ST1G4ZDXED8XM2XJ4Q4GJ7F4PG4EJQ1KKXVPSAX13"
# VITE_TOKEN_X="ST1G4ZDXED8XM2XJ4Q4GJ7F4PG4EJQ1KKXVPSAX13.token-x-c4::token-x"
# VITE_TOKEN_Y="ST1G4ZDXED8XM2XJ4Q4GJ7F4PG4EJQ1KKXVPSAX13.token-y-c4::token-y"
# VITE_POOL_CONTRACT="ST1G4ZDXED8XM2XJ4Q4GJ7F4PG4EJQ1KKXVPSAX13.pool-v5-c4"
# VITE_STACKS_NETWORK="testnet" # or "mainnet"
